---
import Layout from "../layouts/Layout.astro";

const reviewOptions = [
	{
		platform: "goodreads",
		title: "Review on Goodreads",
		copy: "Help fantasy readers discover The Creatures Lurk by adding your rating or review.",
		label: "Review here",
		href: "https://www.goodreads.com/book/show/255607560-the-creatures-lurk",
	},
	{
		platform: "fable",
		title: "Review on Fable",
		copy: "Share the book with your reading circles and let other fantasy fans know what you thought.",
		label: "Review here",
		href: "https://fable.co/book/the-creatures-lurk-by-topher-knowles-B0H9BNDGXD",
	},
	{
		platform: "amazon",
		title: "Review on Amazon",
		copy: "A short Amazon review makes a huge difference once readers finish the book.",
		label: "Review here",
		href: "https://www.amazon.co.uk/Creatures-Lurk-Veilhost-Topher-Knowles/dp/106684870X",
	},
];
---

<Layout title="Reviews | The Veilhost Trilogy">
	<section class="reviews-hero">
		<div class="page-shell">
			<p class="kicker">The Creatures Lurk</p>
			<h1>Reviews</h1>
			<p class="review-note">Finished the book? Your review helps new readers find it.</p>
		</div>
	</section>

	<section class="review-options page-shell" aria-label="Review options">
		{
			reviewOptions.map((option) => (
				<article class="review-card">
					<div class:list={["review-logo", `review-logo-${option.platform}`]} aria-label={`${option.platform} logo`}>
						{option.platform}
					</div>
					<br>
					<p>{option.copy}</p>
					<a href={option.href} class="availability" target="_blank">{option.label}</a>
				</article>
			))
		}
	</section>
</Layout>

<style>
	.reviews-hero {
		padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 5vw, 3.5rem);
		background: linear-gradient(180deg, rgba(8, 7, 5, 0.96), rgba(8, 7, 5, 0.78));
		color: var(--color-white);
		text-align: center;
	}

	.kicker {
		margin-bottom: 1.2rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	h1 {
		margin-bottom: 1rem;
		font-size: clamp(4.5rem, 12vw, 9rem);
	}

	.review-note {
		display: inline-block;
		margin-bottom: 0;
		border-block: 2px solid currentColor;
		padding: 0.4rem 0;
		font-size: clamp(1.1rem, 3vw, 1.85rem);
		font-weight: 900;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.review-options {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 4vw, 2rem);
		padding: clamp(3rem, 8vw, 6rem) 0;
	}

	.review-card {
		display: grid;
		align-content: start;
		gap: 1rem;
		min-height: 340px;
		border: 3px solid var(--color-black);
		background: var(--color-white);
		padding: clamp(1.4rem, 4vw, 2.5rem);
		box-shadow: 12px 12px 0 var(--color-black);
	}

	.review-logo {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		min-height: 3rem;
		color: var(--color-black);
		font-size: clamp(1.7rem, 4vw, 2.8rem);
		font-weight: 900;
		letter-spacing: -0.06em;
		line-height: 1;
		text-transform: lowercase;
	}

	.review-logo-goodreads {
		font-family: Georgia, "Times New Roman", serif;
		letter-spacing: -0.08em;
	}

	.review-logo-fable {
		border: 3px solid currentColor;
		border-radius: 999px;
		padding: 0.3rem 0.75rem;
		font-size: clamp(1.35rem, 3vw, 2rem);
		letter-spacing: -0.03em;
	}

	.review-logo-amazon {
		position: relative;
		font-family: Arial, Helvetica, sans-serif;
	}

	.review-logo-amazon::after {
		content: "";
		position: absolute;
		left: 1.7rem;
		right: 0.3rem;
		bottom: -0.35rem;
		height: 0.45rem;
		border-bottom: 4px solid var(--color-ember);
		border-radius: 50%;
		transform: rotate(-4deg);
	}

	h2 {
		margin: 0;
		font-size: clamp(2.1rem, 4vw, 4rem);
	}

	.review-card p {
		margin-bottom: 0;
		font-weight: 700;
	}

	.availability {
		width: fit-content;
		margin-top: auto;
		background: var(--color-black);
		padding: 0.5rem 0.75rem;
		color: var(--color-white);
		font-size: 0.9rem;
		font-weight: 900;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
	}

	@media (max-width: 900px) {
		.review-options {
			grid-template-columns: 1fr;
		}
	}
</style>
